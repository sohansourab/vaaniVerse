# ── LLM provider switch ────────────────────────────────────────────────────────
# "ollama" (default, local) or "groq" (opt-in).
LLM_PROVIDER=ollama

# ── Ollama (default provider) ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Groq (opt-in) ──────────────────────────────────────────────────────────────
# Leave EMPTY here. Supply a real key via the shell environment or your
# deployment platform's secret store — never commit it.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ── Embeddings / vector store ──────────────────────────────────────────────────
VECTOR_BACKEND=faiss
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=vaaniverse

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SPACY_MODEL=en_core_web_sm

# ── Retrieval ──────────────────────────────────────────────────────────────────
TOP_K=5
# Fallback cutoff for a script with no calibrated value. The shipped defaults
# below are measured on the 53-question gold set (see docs/EVALUATION.md):
#   Telugu 0.41 → 23/23 in-corpus pass, 1/3 near-miss OOD probes pass
#   Roman/English 0.46 → 12/14 in-corpus pass, 0/13 OOD probes pass
# A single 0.45 passed 81.1% in-corpus; per-script raises that to 94.6%.
SCORE_THRESHOLD=0.45
SCORE_THRESHOLD_TELUGU=0.41
SCORE_THRESHOLD_ROMAN=0.46
SCORE_THRESHOLD_MIXED=0.45

# ── Hybrid retrieval (BM25 + dense, fused by RRF) ──────────────────────────────
# OFF by default. Measured on the original 40-question set: recall@5 0.900 → 0.9333
# but MRR 0.6856 → 0.6656, i.e. it surfaces more correct pages while ranking the
# first correct one lower. Enable to trade rank precision for recall.
HYBRID_ENABLED=false
HYBRID_ALPHA=0.5
HYBRID_CANDIDATES=30
RRF_K=60

# ── Reranking (optional second stage) ──────────────────────────────────────────
# OFF by default, on measurement: recall@5 0.900 → 0.9333 (+1 question of 30) at
# +64 s per query on CPU, plus a second ~2.3 GB model that does not fit beside
# BGE-M3 on Streamlit Community Cloud. See docs/EVALUATION.md.
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_CANDIDATES=20
RERANK_THRESHOLD=0.5

# ── OCR (scanned / image-only pages) ───────────────────────────────────────────
# Fires only on pages with no usable text layer. Needs the tesseract binary on
# PATH (packages.txt installs tesseract-ocr + tesseract-ocr-tel on Streamlit Cloud).
OCR_ENABLED=true
OCR_ENGINE=auto
OCR_LANG=te,en
OCR_DPI=200
OCR_MIN_CHARS=16
# Grayscale + autocontrast + Otsu binarization before recognition; psm 6 assumes a
# uniform block of body text (better than the default 3 for a book page).
OCR_PREPROCESS=true
OCR_PSM=6

# ── Conversation memory ────────────────────────────────────────────────────────
# The server is stateless: clients send prior turns in the /query body. They are
# used as chat context only and can never be cited as sources.
MAX_HISTORY_TURNS=4
MAX_HISTORY_CHARS=2000

# ── Answer verification (claim ↔ citation) ─────────────────────────────────────
CITATION_VERIFY_ENABLED=true
CITATION_SUPPORT_MIN=0.12
CITATION_MAX_INVALID=0

# ── API security & limits ──────────────────────────────────────────────────────
# When set, /ingest, DELETE /index/reset and /admin/requests require this value in
# an X-API-Key header. Leave empty for open local development (GET /health then
# reports auth_configured=false, so the exposure is visible). Supply a real key via
# the environment or a secret store — never commit it.
VANIVERSE_API_KEY=
# Require the same key on *every* route, including /health, /search and /query.
REQUIRE_AUTH_FOR_ALL=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
INGEST_LIMIT_PER_HOUR=10
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=2000

# ── API ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Off by default: uvicorn's reloader spawns a supervisor + child, doubles model
# memory and is wrong inside a container. Set true only for local code changes.
API_RELOAD=false
